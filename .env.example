LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=ezs
LIVEKIT_API_SECRET=change-me-to-at-least-32-characters-long
LIVEKIT_NODE_IP=127.0.0.1
